# PostgreSQL : ce port est publié uniquement sur 127.0.0.1 pour DataGrip.
DB_PORT=5432
DB_NAME=indusense_db
DB_USER=indusense_user
DB_PASSWORD=dbpassword
# Conserver la version existante ; un changement majeur exige une migration du volume.
DB_TAG=15.1
DB_DATA_VOLUME=indusense-db-data

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=indusense
